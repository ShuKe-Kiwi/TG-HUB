# Copy to ~/.tg-hub/production.env and set file mode to 0600.
# Load with TG_HUB_ENV_FILE=~/.tg-hub/production.env.

CONFIG_SCHEMA_VERSION=1
APP_NAME=tg-hub
APP_ENV=production
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=8010
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost/tg_hub_dev
WATCHLIST_PATH=~/.tg-hub/watchlist.json

TELEGRAM_API_ID=REPLACE_WITH_API_ID
TELEGRAM_API_HASH=REPLACE_WITH_API_HASH
TELEGRAM_SESSION_NAME=~/.tg-hub/telethon
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
TELEGRAM_ALLOWED_CHAT_IDS=REPLACE_WITH_CHAT_IDS
TELEGRAM_NOTIFY_CHAT_IDS=REPLACE_WITH_CHAT_IDS

MONITOR_AUTO_START=false
HEARTBEAT_PATH=~/.tg-hub/runtime/heartbeat.jsonl
LOG_DIR=~/.tg-hub/logs
BACKUP_DIR=~/.tg-hub/backups
