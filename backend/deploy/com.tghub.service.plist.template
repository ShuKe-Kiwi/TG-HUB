<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tghub.service</string>
  <key>ProgramArguments</key><array><string>__START_SCRIPT__</string></array>
  <key>WorkingDirectory</key><string>__BACKEND_DIR__</string>
  <key>EnvironmentVariables</key><dict><key>TG_HUB_ENV_FILE</key><string>__ENV_FILE__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/app.stdout.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/app.stderr.log</string>
</dict></plist>
