# tg-hub environment variables
# Copy to .env and modify as needed

# Database
DATABASE_URL=postgresql+asyncpg://localhost/tg_hub_dev
TEST_DATABASE_URL=postgresql+asyncpg://localhost/tg_hub_test

# App
CONFIG_SCHEMA_VERSION=1
APP_NAME=tg-hub
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_BIND_HOST=127.0.0.1
ADMIN_PORT=8010

# Logging
LOG_LEVEL=DEBUG

# Local runtime
MONITOR_AUTO_START=false
HEARTBEAT_PATH=~/.tg-hub/runtime/heartbeat.jsonl
LOG_DIR=~/.tg-hub/logs
BACKUP_DIR=~/.tg-hub/backups
